# 로컬 .git 백업 (스왑 전 github용 .git) — 절대 커밋 금지
.git_linux/

# 임시 파일
**/tmp.png

# MOM 녹음 업로드 대기 (build_mom.py) — 커밋 금지
.mom-audio/

# 생성기를 import 하면 생긴다 (scripts/test_shows.py)
__pycache__/

# watcher 가 처리한 폴더 기록 (이 머신에만 해당)
scripts/.watch_state.json

# lang-study 녹음 음원 — Release 자산으로만 올린다 (Pages 사이트 상한 1GB)
docs/audio/shows/**/*.mp3
docs/audio/shows/**/*.wav

# 오디오북 (scripts/build_audiobook.py). 올리는 것은 암호화된 docs/audiobook.html, 잠근 음원 docs/audio/audiobook/**/*.bin, config.json.
# 평문 페이지·평문 mp3·잠근 음원 모음(.audiobook-audio)은 올리지 않는다
docs/audiobook-local.html
docs/audio/audiobook/**/*.mp3
.audiobook-audio/

# 전화영어 생성기 캐시 (평문 해시 — 이 머신에만 해당)
scripts/.lesson_cache.json
